# Servidor HTTP
PORT=3010
NODE_ENV=development

# Seguridad y Autenticacion (PBAC)
# En producción, genera una clave segura de 64 caracteres hex con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=reemplazar_con_clave_hex_criptografica_de_64_caracteres_minimo
JWT_EXPIRES_IN=7d

# Persistencia SQLite (better-sqlite3 en modo WAL)
DATABASE_PATH=./data/wilfrido.sqlite

# Almacenamiento Local de Documentos (PDFs, Plantillas)
UPLOAD_LOCATION=./uploads
MAX_FILE_SIZE_MB=25

# Integracion Frontend y Verificacion QR
# En desarrollo: http://localhost:5180
# En produccion: https://wilfridotrujillo.doicela.dev
APP_URL=https://wilfridotrujillo.doicela.dev

# CORS (Orígenes permitidos en desarrollo y producción separados por comas)
# En produccion: https://wilfridotrujillo.doicela.dev
CORS_ORIGIN=http://localhost:5180,https://wilfridotrujillo.doicela.dev
